@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Detalle de historia";
}

<h1>@Model.Titulo</h1>

<dl class="row">
    <dt class="col-sm-2">Sinopsis</dt>
    <dd class="col-sm-10">@Model.Sinopsis</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@Model.Estado</dd>

    <dt class="col-sm-2">Categorías</dt>
    <dd class="col-sm-10">@string.Join(", ", Model.Categorias.Select(c => c.Nombre))</dd>

    <dt class="col-sm-2">Capítulos</dt>
    <dd class="col-sm-10">
        <ul>
@foreach (DTOs.DTOs.CapituloDTO capitulo in Model.Capitulos)
{
            <li>
                @capitulo.Titulo
                @if (capitulo.Id == Model.CapituloInicialId)
                {
                    <strong>(inicial)</strong>
                }
            </li>
}
        </ul>
    </dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Volver al listado</a>
</div>
