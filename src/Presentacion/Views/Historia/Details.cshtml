@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Detalle de historia";
}

<h1>@Model.Titulo</h1>

<div class="card p-4">
<dl class="row">
    <dt class="col-sm-2">Sinopsis</dt>
    <dd class="col-sm-10">@Model.Sinopsis</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@Model.Estado</dd>

    <dt class="col-sm-2">Categorías</dt>
    <dd class="col-sm-10">@string.Join(", ", Model.Categorias.Select(c => c.Nombre))</dd>

    <dt class="col-sm-2">Capítulos</dt>
    <dd class="col-sm-10">
        <ul class="list-unstyled">
@foreach (DTOs.DTOs.CapituloDTO capitulo in Model.Capitulos)
{
            <li class="mb-1">
                @capitulo.Titulo
                @if (capitulo.Id == Model.CapituloInicialId)
                {
                    <strong>(inicial)</strong>
                }
                @* Solo los capítulos intermedios pueden tener un capítulo siguiente (RF04). *@
                @if (capitulo is DTOs.DTOs.CapituloIntermedioDTO)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2" disabled
                            title="Disponible cuando implementemos RF04">
                        Agregar capítulo siguiente
                    </button>
                }
            </li>
}
        </ul>
    </dd>
</dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>
