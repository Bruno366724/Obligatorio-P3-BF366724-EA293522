@model DTOs.DTOs.HistoriaDTO
@using Dominio.Enumerados

@{
    ViewData["Title"] = "Editar historia";
    List<DTOs.DTOs.CategoriaDTO> categorias = ViewBag.Categorias;
}

<div class="d-flex justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card p-4">
            <h1 class="h3 mb-4 text-center">Editar historia</h1>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label for="titulo">Título</label>
                    <input name="titulo" class="form-control" value="@Model.Titulo" />
                </div>
                <div class="form-group">
                    <label for="sinopsis">Sinopsis</label>
                    <textarea name="sinopsis" class="form-control">@Model.Sinopsis</textarea>
                </div>
                <div class="form-group">
                    <label>Categorías</label>
@foreach (DTOs.DTOs.CategoriaDTO categoria in categorias)
{
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="categoriaIds" value="@categoria.Id"
                               checked="@(Model.Categorias.Any(c => c.Id == categoria.Id))" />
                        <label class="form-check-label">@categoria.Nombre</label>
                    </div>
}
                </div>
                <div class="form-group">
                    <label for="estado">Estado</label>
                    <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<EstadoHistoria>()"></select>
                </div>
@* El capitulo inicial solo se puede modificar mientras sea el unico capitulo de la historia. *@
@if (Model.Capitulos.Count == 1)
{
                DTOs.DTOs.CapituloDTO capituloInicial = Model.Capitulos.Single();
                <input type="hidden" name="editaCapituloInicial" value="true" />
                <div class="form-group">
                    <label for="capituloInicialTitulo">Título del capítulo inicial</label>
                    <input name="capituloInicialTitulo" id="capituloInicialTitulo" class="form-control" value="@capituloInicial.Titulo" />
                </div>
                <div class="form-group">
                    <label for="capituloInicialTexto">Texto del capítulo inicial</label>
                    <textarea name="capituloInicialTexto" id="capituloInicialTexto" class="form-control">@capituloInicial.Texto</textarea>
                </div>
}
else
{
                <p class="text-muted mt-2 mb-0">El capítulo inicial ya no se puede modificar porque la historia tiene otros capítulos.</p>
}

                <div class="form-group mt-3">
                    <input type="submit" value="Guardar" class="btn btn-primary w-100" />
                </div>
            </form>
        </div>
        <div class="text-center mt-3">
            <a asp-action="Index">Volver al listado</a>
        </div>
    </div>
</div>
