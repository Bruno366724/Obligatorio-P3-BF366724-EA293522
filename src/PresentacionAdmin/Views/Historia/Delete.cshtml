@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Eliminar historia";
}

<h1>Eliminar historia</h1>

<div class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <p>¿Seguro que querés eliminar esta historia? Se borran también todos sus capítulos y opciones.</p>

    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>

        <dt class="col-sm-2">Capítulos</dt>
        <dd class="col-sm-10">@Model.Capitulos.Count</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
    </form>
</div>
