@{
    ViewData["Title"] = "Nueva historia";
    List<DTOs.DTOs.CategoriaDTO> categorias = ViewBag.Categorias;
}

<div class="d-flex justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card p-4">
            <h1 class="h3 mb-4 text-center">Nueva historia</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label for="titulo">Título</label>
                    <input name="titulo" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="sinopsis">Sinopsis</label>
                    <textarea name="sinopsis" class="form-control"></textarea>
                </div>
                <div class="form-group">
                    <label>Categorías</label>
@foreach (DTOs.DTOs.CategoriaDTO categoria in categorias)
{
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="categoriaIds" value="@categoria.Id" />
                        <label class="form-check-label">@categoria.Nombre</label>
                    </div>
}
                </div>

                <hr />
                <p class="text-muted">Toda historia nace con un capítulo inicial (sin opciones todavía).</p>

                <div class="form-group">
                    <label for="capituloInicialTitulo">Título del capítulo inicial</label>
                    <input name="capituloInicialTitulo" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="capituloInicialTexto">Texto del capítulo inicial</label>
                    <textarea name="capituloInicialTexto" class="form-control"></textarea>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Crear" class="btn btn-primary w-100" />
                </div>
            </form>
        </div>
        <div class="text-center mt-3">
            <a asp-action="Index">Volver al listado</a>
        </div>
    </div>
</div>
