@model List<DTOs.DTOs.RankingHistoriaDTO>

@{
    ViewData["Title"] = "Historias más leídas";
}

<h1>Historias más leídas</h1>
<p class="text-muted">Ordenadas por cantidad de lecturas completadas (que llegaron a un final).</p>

@if (Model.Count == 0)
{
    <p class="text-muted">Todavía no hay lecturas completadas.</p>
}
else
{
    <div class="card p-3">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Historia</th>
                    <th>Lecturas completadas</th>
                </tr>
            </thead>
            <tbody>
@for (int i = 0; i < Model.Count; i++)
{
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i].Titulo</td>
                    <td>@Model[i].CantidadLecturas</td>
                </tr>
}
            </tbody>
        </table>
    </div>
}
