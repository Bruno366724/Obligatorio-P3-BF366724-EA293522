@model PresentacionUsuario.Models.FinalesPorHistoriaViewModel

@{
    ViewData["Title"] = "Finales por historia";
}

<h1>Finales por historia</h1>
<p class="text-muted">Cuántas veces fue alcanzado cada final de la historia elegida.</p>

<div class="card p-3 mb-3">
    <form asp-action="FinalesPorHistoria" method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">Historia</label>
            <select name="historiaId" class="form-select">
                <option value="">-- Elegí una historia --</option>
@foreach (DTOs.DTOs.HistoriaDTO historia in Model.Historias)
{
                <option value="@historia.Id" selected="@(historia.Id == Model.HistoriaId)">@historia.Titulo</option>
}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Ver finales</button>
        </div>
    </form>
</div>

@if (ViewBag.Error is null && Model.HistoriaId.HasValue && Model.Finales.Count == 0)
{
    <p class="text-muted">Esta historia no tiene finales.</p>
}
else if (Model.Finales.Count > 0)
{
    <div class="card p-3">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Final</th>
                    <th>Veces alcanzado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (DTOs.DTOs.AlcanceFinalDTO final in Model.Finales)
{
                <tr>
                    <td>@final.Titulo</td>
                    <td>@final.ContadorAlcances</td>
                    <td>
@if (final.EsMasFrecuente)
{
                        <span class="badge text-bg-secondary">Más frecuente</span>
}
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
    @if (!Model.Finales.Any(final => final.EsMasFrecuente))
    {
        <p class="text-muted mt-2">Ningún final de esta historia fue alcanzado todavía.</p>
    }
}
