@{
    // RF12: oscuro por defecto, claro si el Lector lo eligio.
    bool estiloClaro = PresentacionUsuario.Estilos.PreferenciaEstilo.EsClaro(Context);
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="@(estiloClaro ? "light" : "dark")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lectura</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PresentacionUsuario.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar border-bottom mb-3">
            @{
                // "Hay sesion" si hay token de la Web API guardado.
                bool haySesion = !string.IsNullOrEmpty(Context.Session.GetString("Token"));
                bool esAdministrador = Context.Session.GetString("Rol") == "Administrador";
                bool esLector = Context.Session.GetString("Rol") == "Lector";
            }
            <div class="container-fluid encabezado">
                <div class="encabezado-izquierda">
                    @if (haySesion)
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Historia" asp-action="Index">Historias</a>
                        @if (esAdministrador)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Estadistica" asp-action="HistoriasMasLeidas">Más leídas</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Estadistica" asp-action="FinalesPorHistoria">Finales</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Estadistica" asp-action="UsuariosConMasHistorias">Lectores</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Lectura" asp-action="Historial">Mi historial</a>
                        }
                    }
                </div>
                <a class="navbar-brand m-0" asp-controller="Auth" asp-action="@(haySesion ? "Index" : "Login")">Lectura</a>
                <div class="encabezado-derecha">
                    @if (haySesion)
                    {
                        <span class="navbar-text">@Context.Session.GetString("NombreUsuario") (@Context.Session.GetString("Rol"))</span>
                        @if (esLector)
                        {
                            <form asp-controller="Estilo" asp-action="Cambiar" method="post">
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">@(estiloClaro ? "Modo oscuro" : "Modo claro")</button>
                            </form>
                        }
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Auth" asp-action="Logout">Cerrar sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if ((ViewBag.Error ?? TempData["Error"]) is string error)
            {
                <div class="validation-summary-errors"><ul><li>@error</li></ul></div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - Escoge tu propia aventura
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
