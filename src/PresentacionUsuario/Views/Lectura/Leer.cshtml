@model PresentacionUsuario.Models.LeerViewModel

@{
    ViewData["Title"] = Model.Historia.Titulo;
    bool terminada = Model.Lectura.FechaFin.HasValue;
}

<p class="text-muted mb-1">@Model.Historia.Titulo</p>
<h1>@Model.CapituloActual.Titulo</h1>

@if (TempData["Error"] is string error)
{
    <div class="validation-summary-errors"><ul><li>@error</li></ul></div>
}

<div class="card p-4 mb-3">
    <p class="mb-0">@Model.CapituloActual.Texto</p>
</div>

@if (terminada)
{
    <div class="card p-4">
        <p class="mb-3">
            <strong>Llegaste a un final.</strong> Para probar otro camino, tenés que
            empezar una lectura nueva de esta historia.
        </p>
        <form asp-controller="Historia" asp-action="Details" asp-route-id="@Model.Historia.Id" method="get" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary">Volver a la historia</button>
        </form>
    </div>
}
else if (Model.CapituloActual is DTOs.DTOs.CapituloIntermedioDTO capituloIntermedio)
{
    <div class="card p-4">
        <p class="text-muted">¿Qué hacés?</p>
        <form asp-action="Avanzar" method="post">
            <input type="hidden" name="id" value="@Model.Lectura.Id" />
@foreach (DTOs.DTOs.OpcionDTO opcion in capituloIntermedio.Opciones)
{
            <button type="submit" name="opcionId" value="@opcion.Id" class="btn btn-primary w-100 mb-2 text-start">@opcion.Texto</button>
}
        </form>
    </div>
}
