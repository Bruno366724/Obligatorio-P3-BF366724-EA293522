@model List<PresentacionUsuario.Models.HistorialItemViewModel>

@{
    ViewData["Title"] = "Mi historial";
    int mes = ViewBag.Mes;
    int anio = ViewBag.Anio;
}

<h1>Mi historial</h1>

<div class="card p-3 mb-3">
    <form asp-action="Historial" method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">Mes</label>
            <select name="mes" class="form-select">
@for (int m = 1; m <= 12; m++)
{
                <option value="@m" selected="@(m == mes)">@System.Globalization.CultureInfo.GetCultureInfo("es-UY").DateTimeFormat.GetMonthName(m)</option>
}
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">Año</label>
            <input type="number" name="anio" value="@anio" class="form-control" style="width: 8rem" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No tenés lecturas registradas en ese mes.</p>
}
else
{
    <div class="card p-3">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Historia</th>
                    <th>Inicio</th>
                    <th>Completada</th>
                    <th>Final alcanzado</th>
                </tr>
            </thead>
            <tbody>
@foreach (PresentacionUsuario.Models.HistorialItemViewModel item in Model)
{
                <tr>
                    <td>@item.HistoriaTitulo</td>
                    <td>@item.Lectura.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(item.Lectura.FechaFin.HasValue ? "Sí" : "No")</td>
                    <td>@(item.FinalTitulo ?? "—")</td>
                </tr>
}
            </tbody>
        </table>
    </div>
}
