@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = Model.Titulo;
}

<h1>@Model.Titulo</h1>

<div class="card p-4">
    <p>@Model.Sinopsis</p>
    <p>
@foreach (DTOs.DTOs.CategoriaDTO categoria in Model.Categorias)
{
        <span class="badge text-bg-secondary me-1">@categoria.Nombre</span>
}
    </p>
</div>

<div class="mt-3">
    @* RF07: arranca una lectura nueva desde el capitulo inicial. Es un POST (crea un
       recurso) aunque se dispare desde un link visualmente. *@
    <form asp-controller="Lectura" asp-action="Iniciar" method="post" class="d-inline">
        <input type="hidden" name="historiaId" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Comenzar a leer</button>
    </form>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>
